{
  "name": "sudowall",
  "private": true,
  "description": "Open-source firewall for AI agents. Nothing moves until it's checked.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . && prettier --check .",
    "format": "prettier --write .",
    "secrets": "gitleaks git --no-banner --redact .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "demo:setup": "pnpm build && node examples/scripted-agent/dist/setup.js",
    "package": "pnpm build && node scripts/build-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
