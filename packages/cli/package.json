{
  "name": "tortoisegate",
  "version": "0.0.0",
  "private": true,
  "description": "Tortoise Gate: open-source firewall for AI agents. Nothing moves until it's checked.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tortoisegate/core": "workspace:*",
    "@tortoisegate/gateway": "workspace:*"
  },
  "bin": {
    "tortoisegate": "./dist/main.js"
  }
}
