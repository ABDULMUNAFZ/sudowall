{
  "name": "tortoisegate",
  "version": "0.0.0",
  "private": true,
  "description": "Tortoise Gate: open-source firewall for AI agents. Nothing moves until it's checked.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "bench:latency": "node bench/latency.mjs"
  },
  "dependencies": {
    "@tortoisegate/core": "workspace:*",
    "@tortoisegate/gateway": "workspace:*",
    "@tortoisegate/ledger": "workspace:*",
    "@tortoisegate/web-ui": "workspace:*"
  },
  "bin": {
    "tortoisegate": "./dist/main.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server-everything": "2.1.0",
    "@modelcontextprotocol/server-filesystem": "2.1.0",
    "@modelcontextprotocol/server-memory": "2.0.1",
    "@tortoisegate/policy": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3"
  }
}
