{
  "name": "@tortoisegate/policy",
  "version": "0.0.0",
  "private": true,
  "description": "Tortoise Gate policy DSL, evaluator, templates and explanations.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
